// ============================================================================
// Prisma + SQLite 数据模型（wayfinder #310 草案 + #311/#328 扩展 · issue #333 落地）
//
// 来源：docs/research/310-prisma-schema-draft.prisma（已过 prisma validate）。
// 本期（M0/M1）扩展：User 新增 mustChangePassword / maxContainers（#311 C1 + #319 /me 要求，
// 310 草案 User 缺这两列）。其余 5 实体原样平移（容器/WIKI/桥接是后续切片，但 schema 一次落地）。
//
// 平移映射见 310 草案头部注释。目标 Prisma 7：generator=prisma-client（TS）+ driver adapter
// （@prisma/adapter-better-sqlite3），datasource 仅 provider、url 在 prisma.config.ts / PrismaClient。
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// User —— 账号实体（管理员 + 普通用户双角色）
//
// #311/#328 扩展（相对 310 草案）：
//   - mustChangePassword  bootstrap/重置/新建账号置 true（C1 强制改密）
//   - maxContainers       per-user 配额，admin 可改，超额拒 20042
// ---------------------------------------------------------------------------
enum Role {
  admin
  user
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique // 登录名（Django UnicodeUsernameValidator 同语义）
  email              String?  @unique // 可空；OIDC 首登常以此为主键对齐
  passwordHash       String?  // bcrypt 散列；纯 OIDC 账号可空 → 应用层禁空密码登录
  role               Role     @default(user)
  isActive           Boolean  @default(true) // 平移 Django is_active（软禁用，不删行）
  mustChangePassword Boolean  @default(false) // #311 C1：首登/重置后强制改密
  maxContainers      Int      @default(3) // #311 配额；默认值经 env DEFAULT_MAX_CONTAINERS 在应用层覆盖

  // --- OAuth2 预留（#311 O1 仅骨架；此处仅留形状）---
  oidcSubject String? // OIDC sub claim
  oidcIssuer  String? // OIDC issuer
  @@unique([oidcIssuer, oidcSubject]) // 同 issuer 下 sub 唯一（双可空时 SQLite 视为 distinct）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containers    Container[]
  refreshTokens RefreshToken[]
  textTraceLogs TextTraceLog[]
  figures       Figure[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// TextTraceLog - generated-content provenance/audit records.
//
// Each completed assistant generation gets one row that links the final output
// to the triggering user, client IP, container/session/run, and a stable hash.
// The text itself is not modified; this supports the "content message" and
// "digital signature/hash" screenshots in the provenance sample document.
// ---------------------------------------------------------------------------
enum TextTraceStatus {
  success
  failed
}

model TextTraceLog {
  id            String          @id @default(cuid())
  traceId       String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  username      String
  ipAddress     String
  containerName String?
  sessionKey    String?
  runId         String?
  inputText     String          @default("")
  outputText    String          @default("")
  outputHash    String          @default("")
  status        TextTraceStatus @default(success)
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([status])
  @@map("text_trace_logs")
}

// ---------------------------------------------------------------------------
// RefreshToken —— refresh token 持久化（重写新增；现状 simplejwt 无状态、无表）
//
//   - tokenHash         存 sha256 散列不落明文（零信任）
//   - revokedAt         旋转或撤销时置位；旧 token 重放即判无效
//   - replacedByTokenId 旋转链：新 token 指回被它替换的旧 token（reuse 检测）
// ---------------------------------------------------------------------------
model RefreshToken {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tokenHash         String   @unique // 散列唯一索引：查找 + 防重
  expiresAt         DateTime
  revokedAt         DateTime? // null=有效；置位=已撤销/已旋转
  replacedByTokenId String? // 旋转链指针（R1 reuse 检测）

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Container —— 一个 OpenClaw 容器实例的记账行（平移 containers.Instance，+ownerId 隔离）
//
// name 全局唯一（#312 定夺，非按用户）。本期 M1 仅用于 GET /users 计 containerCount，
// 容器生命周期由 M2 实现；schema 一次落地。
// ---------------------------------------------------------------------------
enum ContainerStatus {
  creating
  running
  stopped
  removing
  error
}

model Container {
  id   String @id @default(cuid())
  name String @unique // DNS-label：^[a-z][a-z0-9-]{2,29}$（应用层校验）
  port Int    @unique

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  token          String // 应用层加密后的密文
  tokenEncrypted Boolean @default(false)
  homeDir        String // bind-mount 宿主路径 instances/<id>/home（代系绑定 #360）
  containerId    String @default("") // run 前未知；空串而非 NULL
  status         ContainerStatus @default(creating)
  image          String
  leaseExpiresAt DateTime? // null=无保护

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pairing        Pairing?
  modelProviders ModelProvider[]

  @@index([ownerId])
  @@map("containers")
}

// ---------------------------------------------------------------------------
// Pairing —— 设备配对记账行（平移 chat.Pairing，一对一 Cascade）。M4 实现。
// ---------------------------------------------------------------------------
enum PairingStatus {
  unpaired
  pending
  paired
  error
}

model Pairing {
  id          String    @id @default(cuid())
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  containerId String    @unique // 一对一

  deviceId                String @default("")
  publicKeyPem            String @default("")
  privateKeyPem           String @default("") // 密文
  privateKeyPemEncrypted  Boolean @default(false)
  deviceToken             String @default("") // @deprecated 方向 A：deviceToken 回浏览器 localStorage（chat/deviceAuth.ts），此列不再读写（保留避免生产 DROP COLUMN 迁移）
  deviceTokenEncrypted    Boolean @default(false) // @deprecated 同上
  scopesJson              String @default("[]")
  pairingRequestId        String @default("")
  status                  PairingStatus @default(unpaired)
  attemptVersion          Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("pairings")
}

// ---------------------------------------------------------------------------
// ModelProvider —— 一个容器的一个 model provider 行（平移 models.ModelProvider）。M3 实现。
// ---------------------------------------------------------------------------
enum ProviderApi {
  // Prisma enum 值须为合法标识符 → 下划线名 + @map 落连字符真值
  openai_completions @map("openai-completions")
  anthropic_messages @map("anthropic-messages")
}

model ModelProvider {
  id          String    @id @default(cuid())
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  containerId String

  providerId  String // openclaw.json models.providers 的 map key；DNS-label
  api         ProviderApi
  baseUrl     String
  apiKeyEnvId String // ^[A-Z][A-Z0-9_]{0,127}$（应用层校验）
  authHeader  Boolean     @default(true)
  modelsJson  String // JSON 文本

  createdAt DateTime @default(now())

  @@unique([containerId, providerId])
  @@map("model_providers")
}

// ---------------------------------------------------------------------------
// Figure —— AutoFigure 用户可见领域资源（docs/autofigure/spec.md §1 · grilling §2）。
// Figure 1:1 GenerationJob（两表职责分离：Figure 承载领域资源语义，Job 承载执行状态）。
// ownerId 只由认证的 researcher-service 身份（JWT）派生，永不来自客户端提交（grilling §3）。
// V1 无 Figure 删除（owner 与 admin 均无），本模型不含删除/软删语义。
// ---------------------------------------------------------------------------
model Figure {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  prompt  String // 用户可见的 text-to-figure 生成输入（zod 校验后入库）

  // T02 幂等（docs/autofigure/tickets/T02-idempotent-figure-creation.md · grilling §17）：
  // Idempotency-Key 按 (ownerId, idempotencyKey) 唯一（唯一索引是并发重复创建去重的最终仲裁）。
  // nullable 容 T02 前既有行（升级脚本走 ALTER TABLE ADD COLUMN，无 NOT NULL 默认可给）；
  // 应用层恒非空（Idempotency-Key 请求头必带，缺 → 90002）。
  idempotencyKey String?

  // T06 产物持久化（docs/autofigure/tickets/T06-artifact-persistence-png.md · grilling §6）：
  // xml（文本）+ png（SQLite BLOB）+ evaluation（文本 JSON）仅在 Job 提交 succeeded 终态时
  // 一并原子写入（runner persistSucceededWithArtifacts，T04 围栏保证 failed 后迟到成功不写）；
  // queued/running/failed 恒 null。png 用 Prisma Bytes（= Uint8Array）。evaluation 是 Port 边界
  // 已归一化的非敏感 JSON 载荷（T07 适配器负责从 raw 执行输出归一化；本行绝不落 raw provider/
  // Python 响应/栈/凭证）。list/detail 公开投影不含本三列（下载契约：仅 owner 且仅 succeeded）。
  xml        String? // 生成产物 XML（文本）
  png        Bytes? // 生成产物 PNG（SQLite BLOB）
  evaluation String? // 生成产物 evaluation（文本 JSON）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job GenerationJob? // 1:1（figureId @unique）

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId])
  @@map("figures")
}

// ---------------------------------------------------------------------------
// GenerationJob —— AutoFigure 一次后台执行的持久化记录（docs/autofigure/spec.md §1-2）。
// 本表只承载执行状态契约；状态机转换 / errorMessage 填充由 T03 runner 实现（T01 只建列）。
// 状态值集（queued/running/succeeded/failed）来自 spec §2 已批准状态机，T01 仅落默认 queued。
// ---------------------------------------------------------------------------
enum GenerationJobStatus {
  queued
  running
  succeeded
  failed
}

model GenerationJob {
  id      String   @id @default(cuid())
  figure  Figure   @relation(fields: [figureId], references: [id], onDelete: Cascade)
  figureId String @unique // 1:1 Figure ↔ Job（grilling §2：非为未来 1:N 预留）
  status       GenerationJobStatus @default(queued)
  errorMessage String? // 失败原因（非敏感）；runner 填充，T01 恒 null
  startedAt    DateTime? // T03：原子领取（queued→running）时刻置位，恒在 running 期间非空
  finishedAt   DateTime? // T03：终态（succeeded|failed）写入时刻置位；running/queued 恒 null
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("generation_jobs")
}
