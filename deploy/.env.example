# deploy/.env.example —— 复制为 deploy/.env 后填写

# --- 必填 ---
# 网关 token：researcher openclaw.json 里 "${GATEWAY_TOKEN}" 占位符由此注入；
# 本仓库 FastAPI 调网关时也用同一值做 Bearer 认证。
GATEWAY_TOKEN=

# 模型 provider key（researcher 默认 minimax；经 SecretRef 运行时读，勿写进 openclaw.json）
LLM_API_KEY=

# --- 可选 ---
# LLM_BASE_URL=https://api.minimaxi.com/anthropic
# LLM_MODEL=minimax/MiniMax-M3

# researcher 仓库（ACautomata/researcher）在本机的克隆路径。
# 注意：相对路径解析基准是 compose 文件所在目录（deploy/），故指向仓库根须用 ../researcher。
# RESEARCHER_DIR=../researcher

# 镜像（默认官方稳定 browser 变体，ADR 0003；生产建议 pin digest）
# OPENCLAW_IMAGE=ghcr.io/acautomata/researcher-service/openclaw:latest   # 派生镜像（issue #588：pdftotext + wiki/workspace 骨架）；可覆盖回官方基线

# 端口绑定地址（默认仅宿主 loopback；本仓库 FastAPI 经 http://127.0.0.1:18789 访问）
# DOCKER_BIND=127.0.0.1

# 网关 bind（lan = FastAPI 跨容器/宿主访问；同 network namespace 可 loopback）
# OPENCLAW_GATEWAY_BIND=lan

# 运行用户（默认 root：A3 delete cleanup 依赖 root chown；官方镜像以 node(1000) 跑，
# 收紧到 node 需配套重做 cleanup，ADR 0003 后续）
# OPENCLAW_RUN_USER=0:0

# --- AutoFigure（T10 dev / T11 prod，可选）---
# 域开关（默认关）。dev：开则 server 装配 AutoFigure runtime，sidecar 经 panel-dev-net 内部可达，无
# 宿主端口。prod（生产 compose 显式 ${AUTOFIGURE_ENABLED:-false}）：默认关，须宿主 .env 显式设 true
# 才开启——flag 关 → server 不装配 AutoFigure runtime、/api/health 独立；sidecar 容器仍随 up -d 启动
# 但未被使用（compose 无 profile 机制）。flag 开 → sidecar 故障经 docker compose health（unhealthy）
# 检测，生成失败走 T07 信封码，不模糊 500。
# AUTOFIGURE_ENABLED=false
# 生成凭证：仅经 env 注入 server → X-Autofigure-Api-Key header 透传 sidecar（不落盘/不入日志/不 commit 假值）。
# prod 为可选 GitHub secret（flag 关空串安全、缺失不导致部署失败；flag 开必需）。
# AUTOFIGURE_LLM_KEY=
# sidecar 地址（默认容器内部服务名 autofigure:8080，dev/prod compose 已内置默认，一般无需设）。
# AUTOFIGURE_SIDECAR_URL=http://autofigure:8080
# 应用执行超时（ms，默认 30min；生产唯一 AutoFigure timeout 契约，见 config.test.ts；生产 compose 显式 1800000）。
# AUTOFIGURE_JOB_TIMEOUT_MS=1800000
# 生产 sidecar 镜像覆盖位（对齐 PANEL_*_IMAGE 先例；仅生产 compose 读，CD 渲染 .env 注入，默认指向
# ghcr.io/.../autofigure:latest，回滚固定到 :<sha>）。
# PANEL_AUTOFIGURE_IMAGE=ghcr.io/acautomata/researcher-service/autofigure:latest
# 门控真实生成 smoke：宿主 vitest 前设 1 即真跑（非 server 容器 env——smoke 是宿主 vitest 读 env，
# 见 deploy/README.md）。门控三条件：docker 可用 + 本值 =1 + AUTOFIGURE_LLM_KEY 非空，缺一自动跳过。
# AUTOFIGURE_SMOKE=1
# smoke 应用执行超时（ms，默认 600000，仅 smoke 域；生产唯一 AutoFigure timeout 仍是 JOB_TIMEOUT_MS）。
# AUTOFIGURE_SMOKE_TIMEOUT_MS=600000
